APP_NAME=AI Digital Twin Simulator
APP_VERSION=0.1.0
APP_STAGE=Step 12: Supabase PostgreSQL Database Integration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
CORS_ALLOW_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Supabase PostgreSQL Database Configuration
# Option 1: Full Session Pooler Connection URL (Port 5432)
# DATABASE_URL=postgresql://postgres.gqilhgcbqkbttbqqgoqb:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Option 2: Discrete connection parameters (Recommended)
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.gqilhgcbqkbttbqqgoqb
DB_PASSWORD=your_supabase_password_here
DB_SSLMODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_ECHO=false
